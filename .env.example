# ==============================================================================
# Environment Configuration Template — AI PM Portfolio & Tools Hub
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# - Variables prefixed with 'VITE_' are bundled into client-side JavaScript.
# - NEVER put production API keys (OpenAI, Anthropic, etc.) into 'VITE_' variables!
# - Phase 2 AI micro-tools should use user-provided keys (in-memory sessionStorage)
#   or be proxied through secure edge functions.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site Metadata & Analytics Configuration
# ------------------------------------------------------------------------------
# Primary apex production domain (redirects to Netlify edge site)
VITE_SITE_URL="https://athur-exp-bot.tech/"

# GoatCounter Analytics (Cookieless, privacy-friendly telemetry)
# Dashboard: https://athur-portfolio.goatcounter.com/
VITE_GOATCOUNTER_CODE="athur-portfolio"

# ------------------------------------------------------------------------------
# 2. Netlify Deployment Credentials (for CI/CD & Netlify CLI)
# ------------------------------------------------------------------------------
# Netlify Personal Access Token (PAT) with limited expiry (e.g. 7-day validity)
# Generated from: Netlify User Settings -> Applications -> Personal access tokens
NETLIFY_AUTH_TOKEN="your_netlify_personal_access_token_here"

# Netlify Site API ID
# Found in: Netlify Site Dashboard -> Site configuration -> General -> Site details -> API ID
NETLIFY_SITE_ID="your_netlify_site_id_here"

# ------------------------------------------------------------------------------
# 3. Phase 2 Micro-Tools Blueprints (Optional / Edge Proxy / BYOK)
# ------------------------------------------------------------------------------
# For future interactive tools (LLM Token Economics Simulator, ASR Model Selector):
# These keys are intended for serverless edge functions or local benchmark scripts.
OPENAI_API_KEY="sk-proj-your_sample_openai_api_key_here"
ANTHROPIC_API_KEY="sk-ant-api03-your_sample_anthropic_api_key_here"
GROQ_API_KEY="gsk_your_sample_groq_api_key_here"
